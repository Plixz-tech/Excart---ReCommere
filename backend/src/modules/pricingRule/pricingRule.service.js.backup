import mongoose from "mongoose";
import DeviceCatalog from "../../models/DeviceCatalog.js";
import ApiError from "../../utils/errors/ApiError.js";
import * as pricingRuleRepository from "./pricingRule.repository.js";
// CREATE PRICING RULE
export const createPricingRule = async (
data,
userId
) => {
if (!data.conditionType) {
throw new ApiError(
400,
"Condition type is required."
);
}
if (!data.operator) {
throw new ApiError(
400,
"Operator is required."
);
}
if (
data.conditionValue ===
undefined ||
data.conditionValue === null
) {
throw new ApiError(
400,
"Condition value is required."
);
}
if (!data.adjustmentType) {
throw new ApiError(
400,
"Adjustment type is required."
);
}
if (
data.adjustmentValue ===
undefined ||
data.adjustmentValue === null
) {
throw new ApiError(
400,
"Adjustment value is required."
);
}
if (
Number(data.adjustmentValue) < 0
) {
throw new ApiError(
400,
"Adjustment value cannot be negative."
);
}
return pricingRuleRepository.create({
brand:
data.brand || "",
model:
data.model || "",
variant:
data.variant || "",
conditionType:
data.conditionType,
conditionKey:
data.conditionKey || "",
operator:
data.operator,
conditionValue:
String(data.conditionValue),
adjustmentType:
data.adjustmentType,
adjustmentValue:
Number(data.adjustmentValue),
active:
data.active !== undefined
? data.active
: true,
createdBy:
userId || null,
updatedBy:
userId || null,
});
};
// GET ACTIVE PRICING RULES
export const getActivePricingRules =
async () => {
return pricingRuleRepository.findActive();
};
// UPDATE PRICING RULE
export const updatePricingRule = async (
pricingRuleId,
data,
userId
) => {
if (
!mongoose.Types.ObjectId.isValid(
pricingRuleId
)
) {
throw new ApiError(
400,
"Invalid pricing rule ID."
);
}
const existing =
await pricingRuleRepository.findById(
pricingRuleId
);
if (!existing) {
throw new ApiError(
404,
"Pricing rule not found."
);
}
const updateData = {
updatedBy:
userId || null,
};
if (
data.brand !== undefined
) {
updateData.brand =
data.brand;
}
if (
data.model !== undefined
) {
updateData.model =
data.model;
}
if (
data.variant !== undefined
) {
updateData.variant =
data.variant;
}
if (
data.conditionType !==
undefined
) {
updateData.conditionType =
data.conditionType;
}
if (
data.conditionKey !==
undefined
) {
updateData.conditionKey =
data.conditionKey;
}
if (
data.operator !==
undefined
) {
updateData.operator =
data.operator;
}
if (
data.conditionValue !==
undefined
) {
updateData.conditionValue =
String(
data.conditionValue
);
}
if (
data.adjustmentType !==
undefined
) {
updateData.adjustmentType =
data.adjustmentType;
}
if (
data.adjustmentValue !==
undefined
) {
if (
Number(
data.adjustmentValue
) < 0
) {
throw new ApiError(
400,
"Adjustment value cannot be negative."
);
}
updateData.adjustmentValue =
Number(
data.adjustmentValue
);
}
if (
data.active !==
undefined
) {
updateData.active =
data.active;
}
return pricingRuleRepository.updateById(
pricingRuleId,
updateData
);
};
// DELETE PRICING RULE
export const deletePricingRule = async (
pricingRuleId
) => {
if (
!mongoose.Types.ObjectId.isValid(
pricingRuleId
)
) {
throw new ApiError(
400,
"Invalid pricing rule ID."
);
}
const existing =
await pricingRuleRepository.findById(
pricingRuleId
);
if (!existing) {
throw new ApiError(
404,
"Pricing rule not found."
);
}
await pricingRuleRepository.deleteById(
pricingRuleId
);
return {
message:
"Pricing rule deleted successfully.",
};
};
// GET NESTED VALUE
const getConditionValue = (
evaluation,
conditionType,
conditionKey
) => {
if (!evaluation) {
return undefined;
}
const conditionValue =
evaluation[conditionType];
if (
conditionValue === undefined ||
conditionValue === null
) {
return undefined;
}
// Direct condition value
// Example:
// evaluation.batteryHealth = 75
// evaluation.screenCondition = "Poor"
if (!conditionKey) {
return conditionValue;
}
// Nested condition value
// Example:
// evaluation.functionalTests.camera = true
// evaluation.accessories.charger = true
if (
typeof conditionValue === "object" &&
!Array.isArray(conditionValue)
) {
return conditionValue[conditionKey];
}
return conditionValue;
};
// CHECK RULE CONDITION
const matchesRule = (
actualValue,
operator,
expectedValue
) => {
if (
actualValue ===
undefined ||
actualValue === null
) {
return false;
}
// ARRAY
if (Array.isArray(actualValue)) {
if (operator === "contains") {
const expectedString =
String(expectedValue)
.trim()
.toLowerCase();
return actualValue.some(
(item) =>
String(item)
.trim()
.toLowerCase() ===
expectedString
);
}
if (operator === "equals") {
return actualValue.some(
(item) =>
String(item)
.trim()
.toLowerCase() ===
String(expectedValue)
.trim()
.toLowerCase()
);
}
if (operator === "not_equals") {
return !actualValue.some(
(item) =>
String(item)
.trim()
.toLowerCase() ===
String(expectedValue)
.trim()
.toLowerCase()
);
}
return false;
}
// BOOLEAN
if (
expectedValue === "true" ||
expectedValue === "false"
) {
const expectedBoolean =
expectedValue === "true";
const actualBoolean =
actualValue === true ||
actualValue === false
? actualValue
: String(actualValue)
.toLowerCase() ===
"true";
switch (operator) {
case "equals":
return (
actualBoolean ===
expectedBoolean
);
case "not_equals":
return (
actualBoolean !==
expectedBoolean
);
default:
return false;
}
}
// NUMBER
const actualNumber =
Number(actualValue);
const expectedNumber =
Number(expectedValue);
const bothNumbers =
!Number.isNaN(
actualNumber
) &&
!Number.isNaN(
expectedNumber
);
if (bothNumbers) {
switch (operator) {
case "equals":
return (
actualNumber ===
expectedNumber
);
case "not_equals":
return (
actualNumber !==
expectedNumber
);
case "less_than":
return (
actualNumber <
expectedNumber
);
case "less_than_or_equal":
return (
actualNumber <=
expectedNumber
);
case "greater_than":
return (
actualNumber >
expectedNumber
);
case "greater_than_or_equal":
return (
actualNumber >=
expectedNumber
);
default:
return false;
}
}
// STRING
const actualString =
String(actualValue)
.trim()
.toLowerCase();
const expectedString =
String(expectedValue)
.trim()
.toLowerCase();
switch (operator) {
case "equals":
return (
actualString ===
expectedString
);
case "not_equals":
return (
actualString !==
expectedString
);
case "contains":
return actualString.includes(
expectedString
);
default:
return false;
}
};
// CALCULATE PRICE
export const calculatePrice = async ({
deviceCatalogId,
evaluation,
}) => {
if (!deviceCatalogId) {
throw new ApiError(
400,
"Device catalog ID is required."
);
}
if (!mongoose.Types.ObjectId.isValid(deviceCatalogId)) {
throw new ApiError(
400,
"Invalid device catalog ID."
);
}
// Always use the catalog stored in the database.
const catalogDevice = await DeviceCatalog.findOne({
_id: deviceCatalogId,
active: true,
});
if (!catalogDevice) {
throw new ApiError(
404,
"Device catalog item not found."
);
}
const numericBasePrice = Number(catalogDevice.valuationPrice);
if (
!Number.isFinite(numericBasePrice) ||
numericBasePrice < 0
) {
throw new ApiError(
400,
"Device valuation price is invalid."
);
}
const normalizedEvaluation =
evaluation && typeof evaluation === "object"
? evaluation
: {};
let totalDeductions = 0;
const appliedRules = [];
const deductions = Array.isArray(catalogDevice.conditionDeductions)
? catalogDevice.conditionDeductions
: [];

for (const deduction of deductions) {
if (deduction.active === false) {
continue;
}
const conditionType = deduction.conditionType;
const deductionName = deduction.name;
const amount = Number(deduction.amount);
if (
!conditionType ||
!deductionName ||
!Number.isFinite(amount) ||
amount < 0
) {
continue;
}

// Support the legacy functionalTests evaluation key.
const isFunctionalCheck =
conditionType === "functionalChecks" ||
conditionType === "functionalTests";
const evaluationKey =
conditionType === "functionalTests" &&
normalizedEvaluation.functionalChecks !== undefined
? "functionalChecks"
: conditionType;
const actualValue = normalizedEvaluation[evaluationKey];
let matched = false;

if (Array.isArray(actualValue)) {
matched = actualValue.some(
(value) =>
String(value).trim().toLowerCase() ===
String(deductionName).trim().toLowerCase()
);
} else if (
actualValue !== null &&
typeof actualValue === "object"
) {
const matchedKey = Object.keys(actualValue).find(
(key) => key.trim().toLowerCase() === deductionName.trim().toLowerCase()
);
if (matchedKey !== undefined) {
// In the UI, true means OK and false means Issue.
matched = isFunctionalCheck
? actualValue[matchedKey] === false
: actualValue[matchedKey] === true;
}
} else {
matched =
String(actualValue ?? "").trim().toLowerCase() ===
String(deductionName).trim().toLowerCase();
}
if (!matched) {
continue;
}
totalDeductions += amount;
appliedRules.push({
ruleId: "",
name: deductionName,
conditionType,
conditionKey: "",
operator: "equals",
conditionValue: deductionName,
actualValue,
adjustmentType: "deduction",
adjustmentValue: amount,
});
}
const finalPrice = Math.max(
0,
numericBasePrice - totalDeductions
);
return {
deviceCatalogId: catalogDevice._id,
basePrice: numericBasePrice,
finalPrice,
totalAdjustment: finalPrice - numericBasePrice,
evaluationConfig: catalogDevice.evaluationConfig,
appliedRules,
};
};